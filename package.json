{
  "name": "hush-ai-data-gatekeeper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first AI prompt data-loss prevention for Chrome and Edge.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && npm run build:extension",
    "build:extension": "esbuild src/extension/content.ts --bundle --format=iife --target=chrome110 --outfile=dist/content.js && esbuild src/extension/background.ts --bundle --format=iife --target=chrome110 --outfile=dist/background.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
